Options -Indexes
DirectoryIndex index.php

<FilesMatch "^(config\.php|config\.sample\.php|README\.md|.*\.sqlite|.*\.log|.*\.lock)$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order deny,allow
        Deny from all
    </IfModule>
</FilesMatch>

# HTTPS erzwingen (auskommentieren, falls der Hoster das bereits übernimmt)
<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteCond %{HTTPS} !=on
    RewriteCond %{HTTP:X-Forwarded-Proto} !=https
    RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]
</IfModule>
